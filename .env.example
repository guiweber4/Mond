# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes em Vercel → Settings → Environment Variables.
# Nunca use prefixo NEXT_PUBLIC_ em segredos.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (anon/publishable). É exposta ao navegador por design; as tabelas têm RLS sem políticas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role). Só servidor: usada para o Storage privado dos arquivos originais.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → Transaction pooler (porta 6543). Ex.:
# postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Acesso: e-mail do administrador (IA e configurações restritas) e, opcionalmente, lista de e-mails permitidos.
APP_ADMIN_EMAIL=
ALLOWED_EMAILS=

# Cofre das chaves de IA: 32 bytes aleatórios em base64 (ex.: `openssl rand -base64 32`).
# Mantenha estável: trocar a chave exige recadastrar as chaves dos provedores.
AI_VAULT_KEY=
